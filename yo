* { box-sizing: border-box; }
:root { color-scheme: dark; }
body {
  margin: 0; min-height: 100vh; font-family: Arial, Helvetica, sans-serif;
  background: radial-gradient(circle at top, #183c35, #071712 65%);
  color: #fff; display: grid; place-items: center; padding: 22px;
}
.game { width: min(100%, 650px); text-align: center; }
.eyebrow { color: #a8f06b; letter-spacing: 4px; font-size: 11px; font-weight: 800; }
h1 { margin: 8px 0; font-size: clamp(34px, 8vw, 58px); font-weight: 1000; letter-spacing: -2px; }
h1 span { color: #a8f06b; }
.subtitle { color: #bdd0c6; margin-top: 5px; }
.scoreboard {
  display: flex; justify-content: center; align-items: center; gap: 38px;
  margin: 26px auto 18px; padding: 15px; max-width: 310px;
  background: #102b23; border: 1px solid #315d49; border-radius: 18px;
}
.scoreboard div:not(.versus) { display: grid; gap: 3px; }
.scoreboard small { color: #a8c5b5; font-size: 10px; letter-spacing: 2px; }
.scoreboard strong { font-size: 34px; }
.versus { color: #a8f06b; font-weight: 900; }
.match-info { display: flex; justify-content: space-between; gap: 10px; font-size: 12px; color: #d6e6dc; margin: 0 auto 12px; max-width: 500px; }
#round { color: #a8f06b; font-weight: bold; }
.pitch {
  position: relative; height: 265px; max-width: 500px; margin: auto; overflow: hidden;
  border: 2px solid #74b95c; border-radius: 16px;
  background: repeating-linear-gradient(0deg, #267448 0 42px, #2c8050 42px 84px);
}
.goal { position: absolute; top: 20px; left: 50%; transform: translateX(-50%); width: 74%; height: 145px; }
.net { position: absolute; inset: 0; border: 7px solid #f4f4e9; background: repeating-linear-gradient(90deg, transparent 0 24px, #ffffff38 25px 27px), repeating-linear-gradient(0deg, transparent 0 22px, #ffffff38 23px 25px); }
.goal-post { position: absolute; background: #fff; }
.goal-post.top { height: 7px; left: 0; right: 0; top: 0; }
.goal-post.left, .goal-post.right { width: 7px; top: 0; bottom: 0; }
.goal-post.left { left: 0; } .goal-post.right { right: 0; }
.keeper { position: absolute; z-index: 2; left: 50%; top: 48px; transform: translateX(-50%); font-size: 52px; transition: left .35s ease; filter: drop-shadow(0 4px 2px #0008); }
.ball { position: absolute; z-index: 3; left: 50%; bottom: -105px; transform: translateX(-50%); font-size: 30px; transition: all .45s ease; }
.ball.shoot-left { left: 20%; bottom: 100px; }
.ball.shoot-center { left: 50%; bottom: 100px; }
.ball.shoot-right { left: 80%; bottom: 100px; }
.grass-line { position: absolute; width: 70%; height: 80px; border: 2px solid #d9f2d1aa; border-bottom: 0; border-radius: 100% 100% 0 0; bottom: -36px; left: 15%; }
.spot { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: white; left: 50%; bottom: 30px; }
.controls { margin-top: 20px; }
.controls p { color: #c5d9ce; font-size: 11px; letter-spacing: 2px; font-weight: bold; }
.shots { display: flex; gap: 10px; justify-content: center; }
button { cursor: pointer; border: 0; border-radius: 10px; padding: 13px 18px; font-weight: 900; color: #102016; background: #a8f06b; }
button:hover { filter: brightness(1.1); transform: translateY(-1px); }
button:disabled { opacity: .45; cursor: not-allowed; transform: none; }
.restart { margin-top: 13px; background: #e8f1eb; padding: 10px 18px; font-size: 11px; }
footer { color: #829b8e; font-size: 11px; margin-top: 22px; }
@media (max-width: 430px) {
  body { padding: 14px; }
  .match-info { font-size: 10px; }
  .shots { gap: 6px; }
  .shots button { padding: 12px 10px; font-size: 11px; }
  .pitch { height: 245px; }
}
